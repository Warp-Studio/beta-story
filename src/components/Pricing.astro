---
---

<section id="pricing">
  <div class="reveal">
    <span class="section-tag">Plans &amp; Pricing</span>
    <div class="gold-rule"></div>
    <h2 class="section-title">Simple Pricing.<br><em>No Surprises.</em></h2>
    <p class="section-body">All plans include mobile-optimised design and WhatsApp sharing. Pick what fits your wedding.</p>
  </div>
  <div class="pricing-grid">

    <!-- STARTER -->
    <div class="pricing-card reveal">
      <div class="plan-name">Starter</div>
      <div class="plan-title">Shubh Aarambh</div>
      <div class="plan-price">₹1,999</div>
      <div class="plan-price-note">Everything you need to get started, without the hassle</div>
      <div class="plan-divider"></div>
      <ul class="plan-features">
        <li>Beautiful template-based wedding site</li>
        <li>RSVP form with email notifications</li>
        <li>Venue location with Google Maps</li>
        <li>Live wedding countdown timer</li>
        <li>Couple story section</li>
        <li>Mobile-optimised &amp; shareable link</li>
        <li>1 round of edits</li>
      </ul>
      <a href="#cta-banner" class="plan-cta plan-cta-outline">Get Started</a>
      <p class="plan-delivery">Delivered in 48–72 hours</p>
    </div>

    <!-- PRO -->
    <div class="pricing-card featured reveal">
      <div class="plan-badge">✦ Most Popular</div>
      <div class="plan-name">Pro</div>
      <div class="plan-title">Shaadi Wali Baat</div>
      <div class="plan-price">₹5,999</div>
      <div class="plan-price-note">For couples who want a polished, fully featured experience</div>
      <div class="plan-divider"></div>
      <ul class="plan-features">
        <li>Everything in Starter, plus —</li>
        <li>Custom domain (e.g. preetiwedsashutosh.com)</li>
        <li>Premium templates</li>
        <li>Photo gallery (pre-wedding &amp; couple pics)</li>
        <li>Background music of your choice</li>
        <li>Multiple events page (Mehndi, Sangeet, Reception)</li>
        <li>Accommodation &amp; travel info section</li>
        <li>2 rounds of edits</li>
      </ul>
      <a href="#cta-banner" class="plan-cta plan-cta-solid">Get Started</a>
      <p class="plan-delivery">Delivered in 24–48 hours</p>
    </div>

    <!-- PREMIUM -->
    <div class="pricing-card reveal">
      <div class="plan-name">Premium</div>
      <div class="plan-title">Shaahi Dulhan</div>
      <div class="plan-price">₹29,999</div>
      <div class="plan-price-note">A fully customised wedding website, designed for you</div>
      <div class="plan-divider"></div>
      <ul class="plan-features">
        <li>Everything in Pro, plus —</li>
        <li>Fully custom-designed site (unique to you)</li>
        <li>Multiple pages with full event details &amp; maps</li>
        <li>Video embed / reel section</li>
        <li>Guest wishes &amp; guestbook wall</li>
        <li>Fast 24-hr delivery guaranteed</li>
        <li>Priority WhatsApp support</li>
      </ul>
      <a href="#cta-banner" class="plan-cta plan-cta-outline">Talk to us</a>
      <p class="plan-delivery">Delivered in 24 hours</p>
    </div>

  </div>
</section>
