---
---

<nav>
  <a class="nav-logo" href="#">MyShaadi<span>Story</span></a>
  <ul class="nav-links">
    <li><a href="#features">Features</a></li>
    <li><a href="#pricing">Pricing</a></li>
    <li><a href="#preview">Preview</a></li>
    <li><a href="#faq">FAQ</a></li>
  </ul>
  <div style="display:flex;align-items:center;gap:12px;">
    <a href="#cta-banner" class="nav-cta">Get Started</a>
    <button class="nav-hamburger" id="navHamburger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>
<div class="nav-mobile-menu" id="navMobileMenu" aria-hidden="true">
  <ul class="nav-mobile-links">
    <li><a href="#features">Features</a></li>
    <li><a href="#pricing">Pricing</a></li>
    <li><a href="#testimonials">Testimonials</a></li>
    <li><a href="#faq">FAQ</a></li>
  </ul>
</div>

<script>
  // Nav scroll state (hide on scroll down, show on scroll up)
  const nav = document.querySelector('nav') as HTMLElement;
  let lastY = window.scrollY;
  let hiddenAt: number | null = null;

  const onScroll = () => {
    const y = window.scrollY;
    nav.classList.toggle('nav--scrolled', y > 48);
    if (y > lastY && y > 220) {
      nav.style.transform = 'translateY(-100%)';
      hiddenAt = y;
    } else if (y < lastY && hiddenAt !== null && (hiddenAt - y) > 220) {
      nav.style.transform = '';
      hiddenAt = null;
    }
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Hamburger toggle
  const hamburger = document.getElementById('navHamburger') as HTMLButtonElement;
  const mobileMenu = document.getElementById('navMobileMenu') as HTMLDivElement;

  hamburger.addEventListener('click', () => {
    const isOpen = hamburger.classList.toggle('open');
    mobileMenu.classList.toggle('open', isOpen);
    hamburger.setAttribute('aria-expanded', String(isOpen));
    mobileMenu.setAttribute('aria-hidden', String(!isOpen));
  });

  // Close mobile menu on link click
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      hamburger.classList.remove('open');
      mobileMenu.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
