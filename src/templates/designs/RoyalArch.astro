        <circle cx="-5"  cy="-20" r="3.5" fill="#F8D840"/>
        <circle cx="18"  cy="-17" r="3"   fill="#F0C828"/>
      </g>
      <!-- Small secondary yellow cluster -->
      <g transform="translate(46 148)">
        <circle cx="0"  cy="0"  r="3.5" fill="#F8D840"/>
        <circle cx="9"  cy="-6" r="3"   fill="#F0C828"/>
        <circle cx="-7" cy="-5" r="3"   fill="#F8D840"/>
      </g>
    </svg>

    <!-- Right arrangement (mirror of left) -->
    <svg class="ra__floral ra__floral--right" viewBox="0 0 200 200"
