          <ellipse cx="0" cy="-30" rx="14" ry="24" fill="#EE96A8" transform="rotate(225)"/>
          <ellipse cx="0" cy="-30" rx="14" ry="24" fill="#F4A8BC" transform="rotate(270)"/>
