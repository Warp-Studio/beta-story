        <ellipse cx="0" cy="-30" rx="14" ry="24" fill="#EE96A8" transform="rotate(315)"/>
        <ellipse cx="0" cy="-19" rx="11" ry="17" fill="#E886A0" transform="rotate(22.5)"/>
