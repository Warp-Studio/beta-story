        <ellipse cx="0" cy="-11" rx="8"  ry="11" fill="#D86688" transform="rotate(190)"/>
        <ellipse cx="0" cy="-11" rx="8"  ry="11" fill="#DC7090" transform="rotate(280)"/>
        <circle r="8" fill="#C04E6E"/>
      </g>
      <!-- White lily / magnolia (right) -->
      <g transform="translate(172 105) rotate(12)">
        <ellipse cx="0" cy="-32" rx="9"  ry="27" fill="#FFFDF2"/>
        <ellipse cx="0" cy="-32" rx="9"  ry="27" fill="#FAFBEA" transform="rotate(60)"/>
        <ellipse cx="0" cy="-32" rx="9"  ry="27" fill="#FFFDF2" transform="rotate(120)"/>
        <ellipse cx="0" cy="-32" rx="9"  ry="27" fill="#FAFBEA" transform="rotate(180)"/>
        <ellipse cx="0" cy="-32" rx="9"  ry="27" fill="#FFFDF2" transform="rotate(240)"/>
        <ellipse cx="0" cy="-32" rx="9"  ry="27" fill="#FAFBEA" transform="rotate(300)"/>
        <circle r="7" fill="#EDD060"/>
      </g>
      <!-- Yellow mimosa cluster -->
      <g transform="translate(97 157)">
        <circle cx="0"   cy="0"   r="5"   fill="#F8D840"/>
        <circle cx="13"  cy="-7"  r="4"   fill="#F0C828"/>
        <circle cx="-10" cy="-9"  r="4"   fill="#F8D840"/>
