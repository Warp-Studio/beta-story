---
interface Props {
  partner1?: string;
  partner2?: string;
  date?: string;
  time?: string;
  venue?: string;
  address?: string;
  rsvp?: string;
  ceremony?: string;
}

const {
  partner1 = 'Name One',
  partner2 = 'Name Two',
  date     = '2025-07-27',
  time     = '8:00 AM',
  venue    = 'Venue Name',
  address  = 'Address, City',
  rsvp     = '',
  ceremony = 'Wedding',
} = Astro.props;

const dateObj = new Date(date);
const isValid = !isNaN(dateObj.getTime());
const day     = isValid ? dateObj.toLocaleDateString('en-US', { weekday: 'long' }).toUpperCase() : '';
const month   = isValid ? dateObj.toLocaleDateString('en-US', { month:   'long' }).toUpperCase() : '';
const dayNum  = isValid ? String(dateObj.getDate()) : '';
const year    = isValid ? String(dateObj.getFullYear()) : '';
---

<div class="ra">

  <!-- ── Clip-path definitions ── -->
  <svg width="0" height="0" style="position:absolute;overflow:hidden" aria-hidden="true">
    <defs>
      <!-- Mughal keel arch — objectBoundingBox so it scales with any size element -->
      <clipPath id="ra-mughal" clipPathUnits="objectBoundingBox">
        <path d="M0,1 L0,0.45 C0.02,0.15 0.22,0 0.5,0 C0.78,0 0.98,0.15 1,0.45 L1,1 Z"/>
      </clipPath>
    </defs>
  </svg>

  <!-- ── Top decorative frieze ── -->
  <div class="ra__frieze" aria-hidden="true">
    <div class="ra__frieze-inner"></div>
  </div>

  <!-- ── Arch card ── -->
  <div class="ra__arch-wrap">

    <!-- Cream arch (clipped to keel shape) -->
    <div class="ra__arch">
      <div class="ra__content">

        <span class="ra__om" aria-label="Om">ॐ</span>

        <p class="ra__together">Together with their families</p>

        <h1 class="ra__name" data-field="partner1">{partner1}</h1>
        <span class="ra__amp">&amp;</span>
        <h1 class="ra__name" data-field="partner2">{partner2}</h1>

        <p class="ra__invite-text">
          cordially invite you to join the occasion<br />of their joyous commitment on
        </p>

        <div class="ra__date-block">
          <span class="ra__date-month" data-field="month">{month}</span>
          <div class="ra__date-row">
            <span class="ra__date-rule" aria-hidden="true"></span>
            <span class="ra__date-day"  data-field="day">{day}</span>
            <span class="ra__date-num"  data-field="dayNum">{dayNum}</span>
            <span class="ra__date-time" data-field="time">{time}</span>
            <span class="ra__date-rule" aria-hidden="true"></span>
          </div>
          <span class="ra__date-year" data-field="year">{year}</span>
        </div>

        <p class="ra__at">at</p>
        <p class="ra__venue-name" data-field="venue"><strong>{venue}</strong></p>
        {address && <p class="ra__venue-addr" data-field="address">{address}</p>}
        {rsvp    && <p class="ra__rsvp"       data-field="rsvp">Kindly RSVP on {rsvp}</p>}

      </div>
    </div><!-- /ra__arch -->

    <!-- ── Gold arch border lines (SVG overlay, not clipped) ── -->
    <svg class="ra__arch-line" viewBox="0 0 1 1" preserveAspectRatio="none"
         aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <!-- Outer glow line -->
      <path d="M-0.014,1 L-0.014,0.47 C0.005,0.13 0.2,-0.018 0.5,-0.018 C0.8,-0.018 0.995,0.13 1.014,0.47 L1.014,1"
            fill="none" stroke="rgba(196,146,28,0.38)" stroke-width="5"
            vector-effect="non-scaling-stroke"/>
      <!-- Main gold border -->
      <path d="M0,1 L0,0.45 C0.02,0.15 0.22,0 0.5,0 C0.78,0 0.98,0.15 1,0.45 L1,1"
            fill="none" stroke="#C4921C" stroke-width="2.2"
            vector-effect="non-scaling-stroke"/>
      <!-- Inner thin border -->
      <path d="M0.028,1 L0.028,0.44 C0.048,0.165 0.24,0.028 0.5,0.028 C0.76,0.028 0.952,0.165 0.972,0.44 L0.972,1"
            fill="none" stroke="rgba(196,146,28,0.55)" stroke-width="1"
            vector-effect="non-scaling-stroke"/>
      <!-- Keystone diamond at peak -->
      <path d="M0.5,-0.006 L0.514,0.018 L0.5,0.042 L0.486,0.018 Z"
            fill="#C4921C"/>
      <!-- Spandrel dots at spring points -->
      <circle cx="0.016" cy="0.445" r="0.012" fill="#C4921C"/>
      <circle cx="0.984" cy="0.445" r="0.012" fill="#C4921C"/>
    </svg>

    <!-- ── Flower corners (inline SVG — no PNG needed) ── -->
    <!-- Left arrangement -->
    <svg class="ra__floral ra__floral--left" viewBox="0 0 200 200"
         xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Leaves -->
      <ellipse cx="30"  cy="175" rx="12" ry="56" fill="#3A6224" opacity="0.92" transform="rotate(-40 30  175)"/>
      <ellipse cx="72"  cy="182" rx="11" ry="48" fill="#477629" opacity="0.92" transform="rotate(-14 72  182)"/>
      <ellipse cx="138" cy="175" rx="11" ry="44" fill="#3A6224" opacity="0.92" transform="rotate(18  138 175)"/>
      <ellipse cx="172" cy="162" rx="10" ry="38" fill="#548330" opacity="0.92" transform="rotate(40  172 162)"/>
      <ellipse cx="108" cy="172" rx="7"  ry="30" fill="#477629" opacity="0.85" transform="rotate(-3  108 172)"/>
      <!-- White gardenia (back, left) -->
      <g transform="translate(64 116) rotate(-14)">
        <ellipse cx="0" cy="-28" rx="13" ry="22" fill="#FAF5EC" opacity="0.97"/>
        <ellipse cx="0" cy="-28" rx="13" ry="22" fill="#F5EFE4" opacity="0.97" transform="rotate(51.4)"/>
        <ellipse cx="0" cy="-28" rx="13" ry="22" fill="#FAF5EC" opacity="0.97" transform="rotate(102.8)"/>
