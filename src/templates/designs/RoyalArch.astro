<style>
  /* ════════════════════════════════════
     ROOT — amber + jali background
  ════════════════════════════════════ */
  .ra {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;

    /* Warm amber stone base */
    background-color: #BF7818;

    /* Jali lattice: two diagonal grids create diamond pattern */
    background-image:
      repeating-linear-gradient(
        45deg,
        transparent 0, transparent 11px,
        rgba(255,218,100,0.22) 11px, rgba(255,218,100,0.22) 12.5px
      ),
      repeating-linear-gradient(
        -45deg,
        transparent 0, transparent 11px,
        rgba(255,218,100,0.22) 11px, rgba(255,218,100,0.22) 12.5px
      ),
      /* Stone block grid */
      repeating-linear-gradient(
        90deg,
        transparent 0, transparent 22px,
        rgba(100,45,0,0.1) 22px, rgba(100,45,0,0.1) 23px
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0, transparent 22px,
        rgba(100,45,0,0.1) 22px, rgba(100,45,0,0.1) 23px
      );
  }

  /* ════════════════════════════════════
     TOP FRIEZE
  ════════════════════════════════════ */
  .ra__frieze {
    width: 100%;
    height: 52px;
    background: #9A5E0C;
    box-shadow: 0 4px 20px rgba(0,0,0,0.38);
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    z-index: 2;
  }
  .ra__frieze::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(255,215,80,0.7) 35%, rgba(255,215,80,0.7) 65%, transparent);
  }
  .ra__frieze::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(0,0,0,0.22);
  }
  .ra__frieze-inner {
    height: 100%;
    background-image:
      repeating-linear-gradient(
        90deg,
        transparent 0, transparent 18px,
        rgba(255,200,70,0.32) 18px, rgba(255,200,70,0.32) 19.5px,
        transparent 19.5px, transparent 38px,
        rgba(0,0,0,0.12) 38px, rgba(0,0,0,0.12) 39.5px
      );
  }

  /* ════════════════════════════════════
     ARCH WRAPPER
  ════════════════════════════════════ */
  .ra__arch-wrap {
    position: relative;
    width: min(300px, 86vw);
    margin-top: 1rem;
    /* overflow visible so flowers protrude past edges */
    overflow: visible;
    z-index: 1;
  }

  /* ════════════════════════════════════
     CREAM ARCH (clipped)
  ════════════════════════════════════ */
  .ra__arch {
    clip-path: url(#ra-mughal);
    /* subtle gradient: brightest at top, warmers at bottom */
    background: linear-gradient(170deg, #FFFCF4 0%, #FAF4E4 45%, #F5EAD4 100%);
    position: relative;
    z-index: 1;
  }

  /* Gold border SVG — sits OVER the arch, not clipped */
  .ra__arch-line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
    overflow: visible;
  }

  /* ════════════════════════════════════
     INVITE CONTENT
  ════════════════════════════════════ */
  .ra__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* top padding: clear past the arch peak (~45% arch height) */
    padding: 20% 1.6rem 140px;
    gap: 0.12rem;
  }

  /* Om symbol — large, deep amber */
  .ra__om {
    font-family: 'Noto Serif Devanagari', 'Noto Sans Devanagari', serif;
    font-size: clamp(2.2rem, 8vw, 3rem);
    color: #7A4A08;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .ra__together {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(0.78rem, 2.9vw, 0.92rem);
    color: #7A4A08;
    letter-spacing: 0.03em;
    margin: 0 0 0.6rem;
  }

  /* Names — ALL CAPS, large */
  .ra__name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: clamp(1.7rem, 7.5vw, 2.5rem);
    color: #6A3E06;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
  }

  .ra__amp {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.1rem, 4.2vw, 1.45rem);
    color: #C4921C;
    line-height: 1.2;
    margin: 0.05rem 0;
  }

  .ra__invite-text {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(0.76rem, 2.7vw, 0.9rem);
    color: #7A4A08;
    line-height: 1.6;
    margin: 0.55rem 0 0;
    opacity: 0.88;
  }

  /* ── Date block ── */
  .ra__date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin: 1rem 0 0.5rem;
    width: 100%;
  }

  .ra__date-month {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.26em;
    color: #7A4A08;
  }

  .ra__date-row {
    display: grid;
    grid-template-columns: 1fr auto auto auto 1fr;
    align-items: center;
    gap: 0.42rem;
    width: 100%;
    max-width: 228px;
  }

  .ra__date-rule {
    display: block;
    height: 1px;
    background: #8B5C0A;
    opacity: 0.4;
  }

  .ra__date-day,
  .ra__date-time {
    font-family: 'Jost', sans-serif;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7A4A08;
    white-space: nowrap;
  }

  .ra__date-num {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: clamp(2.6rem, 10vw, 3.6rem);
    color: #6A3E06;
    line-height: 1;
  }

  .ra__date-year {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: #7A4A08;
  }

  .ra__at {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.88rem;
    color: #7A4A08;
    opacity: 0.72;
    margin: 0.2rem 0 0;
  }

  .ra__venue-name {
    font-family: 'Jost', sans-serif;
    font-weight: 700;
    font-size: clamp(0.78rem, 3vw, 0.92rem);
    letter-spacing: 0.02em;
